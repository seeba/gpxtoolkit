<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="GpxToolkit fixtures" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata>
    <name>Track fixture</name>
    <desc>Single track with one segment</desc>
    <author>
      <name>Fixture Author</name>
      <email id="author" domain="example.com"/>
      <link href="https://example.com/author"><text>Author page</text></link>
    </author>
    <copyright author="Fixture Author">
      <year>2026</year>
      <license>https://creativecommons.org/publicdomain/zero/1.0/</license>
    </copyright>
    <link href="https://example.com/track"><text>Track page</text><type>text/html</type></link>
    <time>2026-05-13T09:59:00Z</time>
    <keywords>fixture, track</keywords>
    <bounds minlat="50.0" minlon="19.0" maxlat="50.002" maxlon="19.001"/>
  </metadata>
  <trk>
    <name>Morning walk</name>
    <cmt>comment</cmt>
    <desc>Walk around the block</desc>
    <src>GPS device</src>
    <link href="https://example.com/walk"/>
    <number>1</number>
    <type>walking</type>
    <trkseg>
      <trkpt lat="50.000" lon="19.000"><ele>200.0</ele><time>2026-05-13T10:00:00Z</time></trkpt>
      <trkpt lat="50.001" lon="19.000"><ele>205.0</ele><time>2026-05-13T10:01:00Z</time></trkpt>
      <trkpt lat="50.002" lon="19.001"><ele>203.0</ele><time>2026-05-13T10:02:00Z</time></trkpt>
    </trkseg>
  </trk>
</gpx>
