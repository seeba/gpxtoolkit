{
  "name": "seeba/gpxtoolkit",
  "description": "A PHP library for parsing and analysing GPX 1.1 files.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Sebastian Pluta",
      "email": "poczta@sebastianpluta.pl"
    }
  ],
  "autoload": {
    "psr-4": {
      "GpxToolkit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "GpxToolkit\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.4",
    "ext-dom": "*",
    "ext-libxml": "*",
    "ext-simplexml": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpunit/phpunit": "^13.0"
  },
  "config": {
    "sort-packages": true
  }
}
