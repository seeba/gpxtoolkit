{
  "name": "seeba/gpxtoolkit",
  "description": "A PHP library for parsing and manipulating GPX files.",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Sebastian Pluta",
      "email": "poczta@sebastianpluta.pl"
    }
  ],
  "autoload": {
    "psr-4": {
      "GpxToolkit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "GpxToolkit\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3",
    "ext-libxml": "*",
    "ext-simplexml": "*",
    "ext-fileinfo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  }
}
